{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (x64)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "C_SHARE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS (arm64)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "C_SHARE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows (x64, static runtime)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "C_SHARE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "coverage",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "C_SHARE_BUILD_EXAMPLES": "OFF",
        "C_SHARE_COVERAGE": "ON"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux (x64, Clang coverage)",
      "inherits": ["coverage", "linux"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-coverage",
      "displayName": "macOS (arm64, Clang coverage)",
      "inherits": ["coverage", "macos"]
    },
    {
      "name": "sanitize",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "C_SHARE_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux (x64, Clang, ASan + LSan + UBSan)",
      "inherits": ["sanitize", "linux"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "C_SHARE_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux (x64, Clang, TSan)",
      "inherits": ["sanitize", "linux"],
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "C_SHARE_SANITIZE": "thread"
      }
    },
    {
      "name": "macos-asan",
      "displayName": "macOS (arm64, ASan + UBSan, no leak checks)",
      "inherits": ["sanitize", "macos"],
      "cacheVariables": {
        "C_SHARE_SANITIZE": "address,undefined"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android (arm64-v8a)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android (x86_64, emulator)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "x86_64",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android (armeabi-v7a)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm-neon-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "armeabi-v7a",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "android-x86",
      "displayName": "Android (x86, legacy emulator)",
      "inherits": "base",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-android",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "x86",
        "ANDROID_PLATFORM": "android-24",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux", "configurePreset": "linux" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" },
    { "name": "macos-coverage", "configurePreset": "macos-coverage" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "macos-asan", "configurePreset": "macos-asan" },
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" },
    { "name": "android-armv7", "configurePreset": "android-armv7" },
    { "name": "android-x86", "configurePreset": "android-x86" }
  ],
  "testPresets": [
    { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } },
    { "name": "macos", "configurePreset": "macos", "output": { "outputOnFailure": true } },
    { "name": "windows", "configurePreset": "windows", "output": { "outputOnFailure": true } },
    { "name": "linux-coverage", "configurePreset": "linux-coverage", "output": { "outputOnFailure": true } },
    { "name": "macos-coverage", "configurePreset": "macos-coverage", "output": { "outputOnFailure": true } },
    {
      "name": "linux-asan",
      "configurePreset": "linux-asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "linux-tsan",
      "configurePreset": "linux-tsan",
      "output": { "outputOnFailure": true },
      "environment": { "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1" }
    },
    {
      "name": "macos-asan",
      "configurePreset": "macos-asan",
      "output": { "outputOnFailure": true },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0:strict_string_checks=1:detect_stack_use_after_return=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    }
  ]
}
